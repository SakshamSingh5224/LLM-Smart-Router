# ---- Local Small LLM (router) served by Ollama ----
OLLAMA_HOST=http://localhost:11434
# CPU-only machine and want it faster? use qwen2.5:0.5b. Have a GPU? try qwen2.5:3b.
ROUTER_MODEL=qwen2.5:1.5b
# Warm-inference p50 budget for the router decision (ms).
# ~1000 is realistic on CPU; on a GPU you should be well under 300.
ROUTER_LATENCY_BUDGET_MS=1000

# ---- LOW-cost tier ----
# "ollama"        -> answers locally with LOW_MODEL (free, no network)
# "openai_compat" -> any OpenAI-compatible API (set LOW_BASE_URL / LOW_API_KEY)
LOW_PROVIDER=ollama
LOW_MODEL=qwen2.5:1.5b
LOW_BASE_URL=
LOW_API_KEY=

# ---- HIGH-cost tier (free Groq API, no credit card) ----
# Get a key at https://console.groq.com/keys
HIGH_BASE_URL=https://api.groq.com/openai/v1
HIGH_API_KEY=paste_your_groq_key_here
HIGH_MODEL=openai/gpt-oss-120b

# ---- Dataset ----
HF_DATASET=routellm/gpt4_dataset
# mixtral_score >= this  ->  cheap model was "good enough"  ->  label "low"
WEAK_SCORE_THRESHOLD=4

# ---- Phase 3: Gateway & Router service ----
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_MAX_TOKENS=512
# aggressive|balanced|conservative -> which calibrated threshold to use by default
ROUTER_MODE=balanced
ROUTER_ARTIFACT_PATH=results/router_artifact.joblib
# Leave empty to run the router IN-PROCESS inside the gateway (simplest, one service).
# Set to e.g. http://localhost:8001 to call the standalone router_service instead
# (matches the plan's "router service, independently scalable" architecture).
ROUTER_SERVICE_URL=
ROUTER_TIMEOUT_S=5.0
GATEWAY_CACHE_ENABLED=true
GATEWAY_CACHE_SIZE=500
GATEWAY_CACHE_TTL_S=3600
GATEWAY_CORS_ORIGINS=*
# both tiers are free by default -> $0; set >0 to simulate a paid deployment's cost dashboard
COST_PER_1K_LOW=0.0
COST_PER_1K_HIGH=0.0

# ---- Phase 4: production hardening ----
# Leave GATEWAY_API_KEY empty for local dev (no auth required). Set it once you
# deploy publicly - the frontend/config.js and k6/locust scripts send it as
# X-API-Key. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=
GATEWAY_RATE_LIMIT_PER_MIN=30
