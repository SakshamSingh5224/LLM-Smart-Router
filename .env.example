# Local MVP 3C
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bharat_knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=10
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_K=10
RERANK_TOP_K=3
RERANKER_MAX_LENGTH=512
RERANK_RELEVANCE_THRESHOLD=0.70
ENABLE_MVP3_RETRIEVAL=true

# Local MVP 3D RAG
ENABLE_MVP3D_RAG=true
LOCAL_RAG_MODEL=qwen2.5:1.5b
LOCAL_RAG_TEMPERATURE=0.2

# MVP 3E - Redis semantic cache
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92

# Gateway / database / authentication
# For local-only development SQLite is acceptable. Use your Neon/Postgres URL in .env for shared deployments.
DATABASE_URL=sqlite:///./sql_app.db
# Replace with a unique random secret (for example: openssl rand -hex 32); never commit your real .env.
JWT_SECRET=replace-with-a-long-random-secret
GRAFANA_ADMIN_PASSWORD=change-this-password
COST_PER_1K_LOW=0.0
COST_PER_1K_HIGH=0.0
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_MAX_TOKENS=512
ROUTER_MODE=balanced
ROUTER_ARTIFACT_PATH=results/router_artifact.joblib
ROUTER_SERVICE_URL=
ROUTER_TIMEOUT_S=5.0
GATEWAY_CACHE_ENABLED=true
GATEWAY_CACHE_SIZE=500
GATEWAY_CACHE_TTL_S=3600
GATEWAY_CORS_ORIGINS=*
GATEWAY_API_KEY=
GATEWAY_RATE_LIMIT_PER_MIN=30

# Providers
LOW_PROVIDER=ollama
LOW_MODEL=qwen2.5:1.5b
HIGH_BASE_URL=https://api.groq.com/openai/v1
HIGH_MODEL=openai/gpt-oss-120b
HIGH_API_KEY=
